# ============================================
# AGENT STATS — LOCAL DEVELOPMENT (OPTIONAL)
# ============================================
# Copy this file to `.env` and fill in keys you actually have.
# Do not commit `.env`. Production / daily use stores credentials
# in the OS keychain via Settings in the app, not this file.
#
# Most services use a web login (Connect / Open Browser) instead
# of an API key. Leave unused keys blank.

# OpenAI / ChatGPT
CHATGPT_API_KEY=

# Anthropic / Claude
CLAUDE_API_KEY=

# Google / Gemini
GEMINI_API_KEY=

# Moonshot / Kimi Code
KIMI_CODE_API_KEY=

# MiniMax
MINIMAX_API_KEY=

# RunwayML
RUNWAYML_API_KEY=

# fal.ai / Kling
FAL_AI_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=
